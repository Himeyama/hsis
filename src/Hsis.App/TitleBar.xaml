<UserControl x:Class="Hsis.App.TitleBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="32" Focusable="False" Loaded="TitleBar_Loaded" Unloaded="TitleBar_Unloaded">
  <UserControl.Resources>
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}">
          <Path Width="10" Height="10" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#20808080"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#40808080"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
            <Setter TargetName="Surface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/>
          </MultiTrigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Close"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions>
            <Setter TargetName="Surface" Property="Background" Value="#A92418"/><Setter Property="Foreground" Value="White"/>
          </MultiTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#40808080"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Background="Transparent">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource CaptionButtonStyle}" Content="M 0,5 L 10,5" Click="Minimize_Click" AutomationProperties.Name="最小化" ToolTip="最小化"/>
      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="M 0,0 L 10,0 10,10 0,10 Z" Click="Maximize_Click" AutomationProperties.Name="最大化または元に戻す" ToolTip="最大化 / 元に戻す"/>
      <Button Style="{StaticResource CaptionButtonStyle}" Content="M 0,0 L 10,10 M 10,0 L 0,10" Tag="Close" Click="Close_Click" AutomationProperties.Name="閉じる" ToolTip="閉じる"/>
    </StackPanel>
  </Grid>
</UserControl>
