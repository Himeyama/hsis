<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <StartupObject>Hsis.App.Program</StartupObject>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Hsis.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <AssemblyName Condition="'$(HsisOutputName)' != ''">$(HsisOutputName)</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Page Include="BuilderWindow.xaml;InstallerWindow.xaml;TitleBar.xaml" />
    <Resource Include="Hsis.ico" />
    <ProjectReference Include="../Hsis.Core/Hsis.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisUninstaller)' == 'true'">
    <AssemblyMetadata Include="Hsis.Uninstaller" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisPackageDirectory)' != ''">
    <EmbeddedResource Include="$(HsisPackageDirectory)/Package.json" LogicalName="Hsis.Package.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisPackageDirectory)' != '' and Exists('$(HsisPackageDirectory)/AppIcon.png')">
    <EmbeddedResource Include="$(HsisPackageDirectory)/AppIcon.png" LogicalName="Hsis.AppIcon.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisPackageDirectory)' != ''">
    <EmbeddedResource Include="$(HsisPackageDirectory)/UninstallerPayload.bin" LogicalName="Hsis.UninstallerPayload" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisPackageDirectory)' == ''">
    <!-- Template sources are files for the builder, not WPF application content.
         Content adds resource lookup metadata that shadows the compiled App.xaml. -->
    <None Include="../../Directory.Build.props" Link="Template/Directory.Build.props" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../Hsis.Core/*.cs;../Hsis.Core/*.csproj" Link="Template/src/Hsis.Core/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="*.cs;*.xaml;*.csproj;app.manifest;Hsis.ico" Link="Template/src/Hsis.App/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
