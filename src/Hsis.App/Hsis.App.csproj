<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The uninstaller must hand off before loading the native runtime. -->
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <SelfContained>true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Hsis.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <AssemblyName Condition="'$(HsisOutputName)' != ''">$(HsisOutputName)</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Hsis.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="../Hsis.Core/Hsis.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisPackageDirectory)' != ''">
    <EmbeddedResource Include="$(HsisPackageDirectory)/Package.json" LogicalName="Hsis.Package.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisPackageDirectory)' != '' and Exists('$(HsisPackageDirectory)/AppIcon.png')">
    <EmbeddedResource Include="$(HsisPackageDirectory)/AppIcon.png" LogicalName="Hsis.AppIcon.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisPackageDirectory)' != ''">
    <EmbeddedResource Include="$(HsisPackageDirectory)/UninstallerPayload.bin" LogicalName="Hsis.UninstallerPayload" />
  </ItemGroup>
  <ItemGroup Condition="'$(HsisPackageDirectory)' == ''">
    <Content Include="../../Directory.Build.props" Link="Template/Directory.Build.props" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Hsis.Core/*.cs;../Hsis.Core/*.csproj" Link="Template/src/Hsis.Core/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="*.cs;*.xaml;*.csproj;app.manifest;Hsis.ico" Link="Template/src/Hsis.App/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Hsis.Bootstrap/**/*" Link="Template/src/Hsis.Bootstrap/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
