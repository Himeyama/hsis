<Application x:Class="Hsis.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hsis.App" ThemeMode="System">
  <Application.Resources>
    <local:DialogBackgroundConverter x:Key="DialogBackgroundConverter"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0A808080"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#40808080"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#40808080"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#27843A"/>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="local:Notice">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:Notice">
        <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel><TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap"/><ContentPresenter/></StackPanel>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsOpen" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
