<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Hsis.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Hsis.App.BuilderWindow" Title="HSIS Studio" Width="940" Height="820" MinWidth="720" MinHeight="600">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="36,12,36,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
          <Border Padding="24" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="01  ソースと出力先" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,16" />
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="インストーラー定義ファイル" Margin="0,0,0,6" />
                  <TextBox x:Name="ScriptPath" />
                </StackPanel>
                <Button Grid.Column="1" Content="選択…" VerticalAlignment="Bottom" Click="PickScript_Click" Margin="12,0,0,0" />
              </Grid>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="ビルド定数" Margin="0,0,0,6" />
                  <TextBox x:Name="BuildConstants" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                </StackPanel>
                <Button Grid.Column="1" Content="定義を読み込む" VerticalAlignment="Bottom" Click="ReadDefinition_Click" Margin="12,0,0,0" />
              </Grid>
              <local:Notice x:Name="DefinitionNotice" IsOpen="False" Margin="0,0,0,16">
                <TextBlock x:Name="DefinitionDetails" TextWrapping="Wrap" />
              </local:Notice>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="出力フォルダー" Margin="0,0,0,6" />
                  <TextBox x:Name="OutputPath" />
                </StackPanel>
                <Button Grid.Column="1" Content="選択…" VerticalAlignment="Bottom" Click="PickOutput_Click" Margin="12,0,0,0" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Padding="24" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="02  セットアップの表示情報" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,16" />
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="アプリ名" Margin="0,0,0,6" />
                  <TextBox x:Name="ProductName" Text="My Application" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                  <TextBlock Text="バージョン" Margin="0,0,0,6" />
                  <TextBox x:Name="ProductVersion" Text="1.0.0" />
                </StackPanel>
              </Grid>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="既定のインストール先" Margin="0,0,0,6" />
                <TextBox x:Name="InstallPath" />
              </StackPanel>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="完了後に起動するファイル（任意）" Margin="0,0,0,6" />
                <TextBox x:Name="LaunchPath" />
              </StackPanel>
              <CheckBox x:Name="AdminRequired" Content="インストール時に管理者の承認を求める" />
            </StackPanel>
          </Border>
          <Border Padding="24" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="03  利用規約" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Grid.Column="1" Content="テキストを読み込む…" Click="PickLicense_Click" />
              </Grid>
              <TextBox x:Name="LicenseText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="240" />
            </StackPanel>
          </Border>
          <Expander Header="ビルドログ" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
            <ScrollViewer Height="160" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="BuildLog" TextWrapping="Wrap" HorizontalAlignment="Stretch" FontFamily="Cascadia Mono, Consolas" />
            </ScrollViewer>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="1" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Status" Text="作成の準備ができました" Margin="0,0,0,4" />
          <ProgressBar x:Name="BuildProgress" Visibility="Collapsed" IsIndeterminate="True" Width="220" HorizontalAlignment="Left" />
        </StackPanel>
        <Button x:Name="OpenSetup" Grid.Column="1" Content="セットアップを起動" IsEnabled="False" Click="OpenSetup_Click" Margin="12,0,0,0" />
      <Button x:Name="BuildButton" Grid.Column="2" Content="インストーラーを作成" Style="{DynamicResource AccentButtonStyle}" Click="Build_Click" Margin="12,0,0,0" />
      </Grid>
    </Grid>
  </Grid>
</Window>
