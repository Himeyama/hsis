<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Hsis.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Hsis.App.InstallerWindow" Title="セットアップ" Width="680" Height="540" MinWidth="600" MinHeight="480">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="SetupContent" Margin="40,16,40,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="44" Height="44">
          <Border x:Name="FallbackIcon" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}">
            <Path Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" Data="M 2,7 L 11,2 20,7 20,18 11,23 2,18 Z M 2,7 L 11,12 20,7 M 11,12 L 11,23" />
          </Border>
          <Image x:Name="ProductIcon" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="アプリのアイコン" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock x:Name="AppName" FontWeight="SemiBold" />
          <TextBlock x:Name="VersionLabel" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="StepLabel" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0" />
      </Grid>
      <Grid Grid.Row="1" Margin="0,24,0,0">
        <StackPanel x:Name="WelcomePage" VerticalAlignment="Center">
          <TextBlock x:Name="WelcomeTitle" Text="セットアップ" Style="{StaticResource TitleLargeTextBlockStyle}" />
        </StackPanel>
        <Grid x:Name="LicensePage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="利用規約" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />
            <TextBlock Text="内容をご確認のうえ、同意する場合はチェックしてください。" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Row="1" CornerRadius="8" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,16,0,0">
            <ScrollViewer>
              <TextBlock x:Name="Terms" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <CheckBox Grid.Row="2" x:Name="Agreement" Content="利用規約に同意します" Checked="Agreement_Changed" Unchecked="Agreement_Changed" Margin="0,16,0,0" />
        </Grid>
        <StackPanel x:Name="DirectoryPage" Visibility="Collapsed">
          <TextBlock Text="インストール先" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="保存先" Margin="0,0,0,6" />
              <TextBox x:Name="Destination" />
            </StackPanel>
            <Button Grid.Column="1" Content="参照…" VerticalAlignment="Bottom" Click="Browse_Click" Margin="12,0,0,0" />
          </Grid>
        </StackPanel>
        <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Center">
          <TextBlock x:Name="ProgressTitle" Text="インストールしています" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />
          <TextBlock Text="完了するまで、このウィンドウを開いたままお待ちください。" TextWrapping="Wrap" Margin="0,0,0,20" />
          <ProgressBar IsIndeterminate="True" Margin="0,0,0,20" />
          <TextBlock x:Name="ProgressStatus" Text="ファイルを配置して設定を適用しています…" TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>
        <StackPanel x:Name="CompletePage" Visibility="Collapsed" VerticalAlignment="Center">
          <Path Width="40" Height="40" Stretch="Uniform" Stroke="{DynamicResource SystemFillColorSuccessBrush}" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,0,20" Data="M 20,1 A 19,19 0 1 1 19.99,1 M 10,20 L 17,27 30,13" />
          <TextBlock x:Name="CompleteTitle" Text="準備ができました" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,0,0,20" TextWrapping="Wrap" />
          <TextBlock x:Name="CompleteText" TextWrapping="Wrap" Margin="0,0,0,20" />
          <CheckBox x:Name="LaunchApp" Content="アプリを起動する" IsChecked="True" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Margin="0,24,0,0">
        <local:Notice x:Name="ErrorBar" IsOpen="False" Margin="0,0,0,16" />
        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,16" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="CancelButton" Content="キャンセル" Click="Cancel_Click" />
          <Button Grid.Column="1" x:Name="BackButton" Content="戻る" Click="Back_Click" Visibility="Collapsed" Margin="12,0,0,0" />
          <Button Grid.Column="2" x:Name="NextButton" Content="次へ" Click="Next_Click" Style="{DynamicResource AccentButtonStyle}" MinWidth="116" Margin="12,0,0,0" />
        </Grid>
      </StackPanel>
    </Grid>
    <Grid x:Name="CloseConfirmation" Visibility="Collapsed" Background="#66000000" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True">
      <Border x:Name="DialogSurface" Margin="24" Padding="28" MaxWidth="440" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource DialogBackgroundConverter}}">
        <StackPanel AutomationProperties.Name="中止の確認">
          <TextBlock x:Name="CloseConfirmationTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="中止すると、このウィンドウを閉じます。" TextWrapping="Wrap" Margin="0,12,0,24"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="AbortButton" Content="中止する" Click="Abort_Click" HorizontalAlignment="Stretch"/>
            <Button x:Name="ContinueButton" Grid.Column="1" Content="続ける" Click="Continue_Click" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="12,0,0,0" IsDefault="True"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
