<Window x:Class="Hsis.App.InstallerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="セットアップ">
  <Grid Padding="40,28,40,24" RowSpacing="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}"><FontIcon Glyph="&#xE896;" Foreground="White" FontSize="22"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="AppName" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" x:Name="StepLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
    <Grid Grid.Row="1">
      <StackPanel x:Name="WelcomePage" Spacing="20" VerticalAlignment="Center"><TextBlock Text="はじめましょう" Style="{StaticResource TitleLargeTextBlockStyle}"/><TextBlock x:Name="WelcomeText" TextWrapping="Wrap" FontSize="16"/><TextBlock Text="作業中のアプリを保存してから、次へ進んでください。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
      <Grid x:Name="LicensePage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="8"><TextBlock Text="利用規約" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="内容をご確認のうえ、同意する場合はチェックしてください。" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><ScrollViewer><TextBlock x:Name="Terms" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></Border><CheckBox Grid.Row="2" x:Name="Agreement" Content="利用規約に同意します" Checked="Agreement_Changed" Unchecked="Agreement_Changed"/></Grid>
      <StackPanel x:Name="DirectoryPage" Visibility="Collapsed" Spacing="20"><TextBlock Text="インストール先" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="アプリをインストールするフォルダーを選択します。" TextWrapping="Wrap"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Destination" Header="保存先"/><Button Grid.Column="1" Content="参照…" VerticalAlignment="Bottom" Click="Browse_Click"/></Grid><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="「インストール」を押すと、このフォルダーへのインストールを開始します。"/></StackPanel>
      <StackPanel x:Name="ProgressPage" Visibility="Collapsed" Spacing="20" VerticalAlignment="Center"><TextBlock x:Name="ProgressTitle" Text="インストールしています" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="完了するまで、このウィンドウを開いたままお待ちください。" TextWrapping="Wrap"/><ProgressBar IsIndeterminate="True"/><TextBlock x:Name="ProgressStatus" Text="ファイルを配置して設定を適用しています…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <StackPanel x:Name="CompletePage" Visibility="Collapsed" Spacing="20" VerticalAlignment="Center"><FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Left"/><TextBlock Text="準備ができました" Style="{StaticResource TitleLargeTextBlockStyle}"/><TextBlock x:Name="CompleteText" TextWrapping="Wrap"/><CheckBox x:Name="LaunchApp" Content="アプリを起動する" IsChecked="True"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="16"><InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error"/><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CancelButton" Content="キャンセル" Click="Cancel_Click"/><Button Grid.Column="1" x:Name="BackButton" Content="戻る" Click="Back_Click" Visibility="Collapsed"/><Button Grid.Column="2" x:Name="NextButton" Content="次へ" Click="Next_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="116"/></Grid></StackPanel>
  </Grid>
</Window>
